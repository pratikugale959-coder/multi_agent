NVIDIA_API_KEY=your-nvidia-api-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_CHAT_MODEL=openai/gpt-oss-20b
NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b
# Optional cross-encoder reranker. Leave empty to keep vector-similarity order.
# The hosted NVIDIA reranker is currently too slow for interactive use, so the
# default is empty. Set it only if your latency budget allows the extra call.
NVIDIA_RERANK_MODEL=
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX_NAME=code-helper
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
TARGET_REPO_PATH=./target_project
EMBEDDING_DIMENSION=2048
CHUNK_SIZE=100
CHUNK_OVERLAP=20
NVIDIA_NIM_API_KEY=your-nvidia-nim-api-key-here
PINECONE_NAMESPACE=code-helper
TOP_K=5
MAX_LLM_CALLS=10
MAX_TOOL_CALLS=3
NVIDIA_MAX_TOKENS=800
NVIDIA_TIMEOUT_SECONDS=60
# gpt-oss reasoning budget: low keeps tool-routing turns fast. Leave empty for
# models that do not support reasoning_effort.
NVIDIA_REASONING_EFFORT=low
DISABLE_MCP_FILESYSTEM=0
